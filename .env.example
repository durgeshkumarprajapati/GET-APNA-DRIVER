# ==============================================================================
# GET APNA DRIVER — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT: This file contains configuration placeholders ONLY.
# NEVER place real API keys, passwords, database credentials, or secret keys here.
# Copy this file to `.env` in production and supply real credentials.

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
# Purpose: Defines Node execution environment (development | test | production)
# Required: YES (Production)
# Provider: System / Node.js
NODE_ENV=production

# Purpose: Application log verbosity (fatal | error | warn | info | debug | trace | silent)
# Required: YES (Production)
# Provider: System / Pino Logger
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Purpose: Primary PostgreSQL database connection string
# Required: YES (Production)
# Provider: Managed PostgreSQL (AWS RDS, GCP Cloud SQL, Supabase, Neon)
# Note: Use SSL parameters in production: sslmode=require
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require

# ------------------------------------------------------------------------------
# Cache & Memory Store (Redis)
# ------------------------------------------------------------------------------
# Purpose: Redis connection URI for GEO index, rate limiting, and session caching
# Required: YES (Production)
# Provider: Managed Redis (AWS ElastiCache, GCP MemoryStore, Upstash, Redis Cloud)
REDIS_URL=redis://redis-host:6379

# ------------------------------------------------------------------------------
# Authentication & Security Sessions
# ------------------------------------------------------------------------------
# Purpose: Minimum 32-character secret key for signing session tokens and cookies
# Required: YES (Production - MUST BE A HIGH-ENTROPY CRYPTOGRAPHIC SECRET)
# Provider: Generated via `openssl rand -hex 32`
AUTH_SECRET=YOUR_MIN_32_CHAR_HIGH_ENTROPY_CRYPTO_SECRET_HERE

# Purpose: HTTP-only session cookie name
# Required: YES
AUTH_SESSION_COOKIE_NAME=gad_session

# Purpose: Session Time-To-Live in seconds (Default: 604800 = 7 days)
# Required: YES
AUTH_SESSION_TTL_SECONDS=604800

# ------------------------------------------------------------------------------
# Identity Provider (Google OAuth 2.0)
# ------------------------------------------------------------------------------
# Purpose: Google OAuth Client ID for Social Authentication
# Required: Optional (Required if Google OAuth is enabled)
# Provider: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Purpose: Google OAuth Client Secret for server-side token exchange
# Required: Optional (Required if Google OAuth is enabled)
# Provider: Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Purpose: OAuth 2.0 Callback Redirect URI
# Required: Optional (Required if Google OAuth is enabled)
# Provider: Google Cloud Console -> Authorized Redirect URIs
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay Integration)
# ------------------------------------------------------------------------------
# Purpose: Public Razorpay Key ID for client-side Checkout SDK
# Required: YES (Production)
# Provider: Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID

# Purpose: Secret Razorpay Key for server-side Order creation and verification
# Required: YES (Production - SECRET)
# Provider: Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Purpose: Webhook Secret for verifying Razorpay payment webhook signatures
# Required: YES (Production - SECRET)
# Provider: Razorpay Dashboard -> Webhooks -> Secret Key
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# Real-Time Push Notifications (Web Push VAPID)
# ------------------------------------------------------------------------------
# Purpose: Public VAPID Key for web push notification subscription registration
# Required: YES (Production)
# Provider: Generated via `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# Purpose: Private VAPID Key for web push notification signing
# Required: YES (Production - SECRET)
# Provider: Generated via `npx web-push generate-vapid-keys`
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# Purpose: Contact email or URL embedded in VAPID headers (mailto: or https://)
# Required: YES (Production)
# Provider: Application Administrator / Operator Contact Email
VAPID_SUBJECT=mailto:support@your-domain.com

# ------------------------------------------------------------------------------
# Local Development Seed Overrides (Ignored in Production)
# ------------------------------------------------------------------------------
# Purpose: Optional password overrides when seeding local development database
# Required: NO (Development only)
# Provider: Local developer preference
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
# SEED_DRIVER_PASSWORD=
