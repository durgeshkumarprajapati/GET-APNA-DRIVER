NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=get_apna_driver
POSTGRES_PASSWORD=get_apna_driver
POSTGRES_DB=get_apna_driver
POSTGRES_PORT=5432
# If running Postgres via `docker compose up -d postgres`, keep the :5432 host port above.
# If connecting to a natively-installed local Postgres listening on the default port, this
# same value works unchanged.
DATABASE_URL=postgresql://get_apna_driver:get_apna_driver@localhost/get_apna_driver

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

AUTH_SECRET=dev-secret-at-least-32-characters-long-key-for-jwt-and-cookies
AUTH_SESSION_COOKIE_NAME=gad_session
AUTH_SESSION_TTL_SECONDS=604800

# Optional — Google OAuth sign-in. Leave unset to disable that login method locally.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional — Razorpay payment provider. Leave unset to use the MockPaymentProvider
# (see src/modules/finance/infrastructure/payment-provider.ts) for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional — override the local dev login accounts `npm run prisma:seed` creates
# (admin@getapnadriver.local / customer@getapnadriver.local / driver@getapnadriver.local).
# Leave unset to use the documented defaults printed by the seed script. Never seeded
# against a production database regardless (guarded by NODE_ENV in prisma/seed.ts).
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_DRIVER_PASSWORD=
