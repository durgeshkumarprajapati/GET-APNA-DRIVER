# ==============================================================================
# GET APNA DRIVER — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (example.env)
# ==============================================================================
# Copy this file to `.env` for local development or production deployment.

# Application Runtime
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://get_apna_driver:get_apna_driver@localhost:5432/get_apna_driver

# Redis Cache & Geo Index
REDIS_URL=redis://localhost:6379

# Authentication & Security
AUTH_SECRET=dev-secret-at-least-32-characters-long-key-for-jwt-and-cookies
AUTH_SESSION_COOKIE_NAME=gad_session
AUTH_SESSION_TTL_SECONDS=604800

# Google OAuth (Optional in local dev)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Razorpay Payments (Optional in local dev, uses mock if unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web Push VAPID Configuration
VAPID_PUBLIC_KEY=BAnRXT4nPwHmUocGFvqkxqTV5mBjDOa053AOArzoY2KtVNmOIy5Tbsm4Ua2tO0HiiZFMMV5UBdUCZgmIz0ZYZNk
VAPID_PRIVATE_KEY=xzXEV5WQxSIpcdat6wCshdds6hF5OY9QCHUhrgOOIcI
VAPID_SUBJECT=mailto:support@getapnadriver.local

# Optional seed user password overrides (Development only)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_DRIVER_PASSWORD=
