NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=gad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=get_apna_driver
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gad:change-me@localhost:5432/get_apna_driver?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

AUTH_SECRET=dev-secret-at-least-32-characters-long-key-for-jwt-and-cookies
AUTH_SESSION_COOKIE_NAME=gad_session
AUTH_SESSION_TTL_SECONDS=604800

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
