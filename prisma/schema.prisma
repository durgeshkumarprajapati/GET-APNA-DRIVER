// Phase 1 (bootstrap): PostgreSQL extensions only.
// Phase 2A (identity foundation): core User identity, RBAC, audit log, and outbox.
// Further domain models are introduced incrementally, phase by phase, per project rules.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // postgis is intentionally not enabled: no column in this schema uses a
  // geography/geometry type yet (all location fields are plain Float
  // latitude/longitude columns). Add it back — with an actual geography
  // column — when a real PostGIS-backed feature needs it; declaring it
  // unused requires every environment to have the postgis OS package
  // installed just to run `prisma migrate deploy`, which isn't worth paying
  // for a capability nothing exercises today.
  extensions = [pgcrypto, citext]
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Account lifecycle status. Deliberately separate from role assignment and
/// from authentication-provider concerns (see UserIdentity).
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED

  @@map("account_status")
}

/// Coarse category of an authentication identity. `providerName` carries the
/// exact source (e.g. "email", "phone", "google") so new OAuth providers can
/// be added without a schema migration.
enum IdentityProviderType {
  EMAIL
  PHONE
  OAUTH

  @@map("identity_provider_type")
}

/// Core human account. Intentionally minimal: profile data belongs to the
/// future Customer/Driver domains, and authentication credentials belong to
/// UserIdentity. A single User can hold multiple roles and multiple
/// authentication identities.
model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountStatus AccountStatus @default(PENDING) @map("account_status")

  /// Locale preference for the user interface ('en', 'hi', 'gu'). Default: 'en'
  preferredLocale String @default("en") @map("preferred_locale")

  // Soft delete: the row is never physically removed. Financial, booking,
  // and audit references must survive account deletion.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities UserIdentity[]
  roles      UserRole[]     @relation("UserRoleUser")

  rolesAssigned UserRole[] @relation("UserRoleAssignedBy")
  rolesRevoked  UserRole[] @relation("UserRoleRevokedBy")

  credentials             UserCredential?
  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  customerProfile         CustomerProfile?
  savedLocations          SavedLocation[]
  customerPreference      CustomerPreference?
  savedPeople             CustomerSavedPerson[]    @relation("CustomerSavedPeople")
  customerCurrentLocation CustomerCurrentLocation?
  driverProfile           DriverProfile?
  customerBookings        Booking[]                @relation("CustomerBookings")
  payments                Payment[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  reporterSafetyIncidents SafetyIncident[]         @relation("ReporterSafetyIncidents")
  customerSafetyIncidents SafetyIncident[]         @relation("CustomerSafetyIncidents")
  assignedSafetyIncidents SafetyIncident[]         @relation("AssignedSafetyIncidents")
  customerReliabilityIncidents TripReliabilityIncident[] @relation("CustomerReliabilityIncidents")
  safetyTimelineEntries   SafetyIncidentTimeline[]
  userRaisedDisputes      Dispute[]                @relation("UserRaisedDisputes")
  assignedDisputes        Dispute[]                @relation("AssignedDisputes")
  disputeLogs             DisputeLog[]
  referralCode            UserReferralCode?
  givenReferrals          Referral[]               @relation("ReferrerUser")
  receivedReferral        Referral?                @relation("ReferredUser")
  customerReviews         Review[]                 @relation("CustomerReviews")
  promotionUsages         PromotionUsage[]
  customerSupportTickets  SupportTicket[]          @relation("CustomerSupportTickets")
  assignedSupportTickets  SupportTicket[]          @relation("AssignedSupportTickets")
  supportMessages         SupportMessage[]
  sentBookingMessages     BookingMessage[]
  initiatedCalls          CallSession[]            @relation("InitiatedCalls")
  customerCalls           CallSession[]            @relation("CustomerCalls")
  customerTaxInvoices     TaxInvoice[]             @relation("CustomerTaxInvoices")
  favoriteDrivers         CustomerFavoriteDriver[] @relation("CustomerFavoriteDrivers")
  customerLoyaltyAccount  CustomerLoyaltyAccount?  @relation("CustomerLoyaltyAccount")
  adminLoyaltyAdjustments LoyaltyPointTransaction[] @relation("AdminLoyaltyAdjustments")
  scheduledRides          ScheduledRide[]          @relation("CustomerScheduledRides")
  organizationMemberships    OrganizationMember[]
  organizationInvitationsSent OrganizationInvitation[]     @relation("InvitedByUsers")
  bookedForBookings          Booking[]                    @relation("BookedForUserBookings")
  approvalRequestsSubmitted  CorporateApprovalRequest[]  @relation("RequesterUsers")
  approvalRequestsReviewed   CorporateApprovalRequest[]  @relation("ApproverUsers")
  recommendationActions      MarketplaceRecommendationAction[] @relation("AdminRecommendationActions")
  aiConversations            AIConversation[]
  aiAuditLogs                AIAuditLog[]
  tripIntelligenceEvents     TripIntelligenceEvent[]
  experienceDismissals       ExperienceDismissal[]

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

/// One authentication identity a User can sign in with. A User has one row
/// per identity (email, phone, or an OAuth provider); the same person is
/// never duplicated into multiple Users just because they add another
/// supported sign-in method.
model UserIdentity {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerType    IdentityProviderType @map("provider_type")
  /// Exact source: "email", "phone", "google", etc. Always populated (never
  /// null) so the (providerName, providerSubject) unique constraint below
  /// works correctly — a nullable discriminator would let Postgres treat
  /// every NULL as distinct and silently allow duplicate email/phone rows.
  providerName    String               @map("provider_name")
  /// Canonical identifier within that provider's namespace: normalized
  /// lowercase email, normalized E.164 phone, or the OAuth `sub` claim.
  providerSubject String               @map("provider_subject")

  /// Populated for EMAIL identities (canonical) and optionally for OAuth
  /// identities that supplied a verified email, so a Google sign-in that
  /// matches an existing email identity can be detected instead of silently
  /// creating a duplicate account. citext makes lookups case-insensitive at
  /// the database level (defense in depth alongside app-level normalization).
  email       String? @db.Citext
  /// Populated for PHONE identities, stored pre-normalized to E.164.
  phoneNumber String? @map("phone_number")

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  emailVerificationTokens EmailVerificationToken[]

  @@unique([providerName, providerSubject], name: "provider_identity_unique")
  @@unique([email])
  @@unique([phoneNumber])
  @@map("user_identities")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

/// A system role. Stored as data (not a Prisma enum) so new roles can be
/// introduced by an admin/seed without a schema migration.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// System roles (CUSTOMER/DRIVER/ADMINISTRATOR) are seeded and must not be
  /// deletable through future admin tooling.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

/// A single server-enforceable permission, named `domain.resource.action`.
model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Role -> Permission grant. A pure join table with no independent identity,
/// so it uses a composite primary key instead of a surrogate UUID.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// User -> Role assignment. Unlike RolePermission this carries its own
/// lifecycle (who assigned/revoked it and when), so it gets a surrogate id.
/// A revoked assignment is kept (not deleted) and reused on re-assignment —
/// `revokedAt IS NULL` is the single source of truth for "currently active".
/// Full historical detail (assigned, revoked, re-assigned...) lives in
/// AuditLog, which is append-only; this table only reflects current state.
model UserRole {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedBy     String?   @map("assigned_by") @db.Uuid
  assignedByUser User?     @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedByUser  User?     @relation("UserRoleRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Cross-cutting: audit + outbox
// ---------------------------------------------------------------------------

/// Append-only record of an important administrative or business action.
/// Never updated or deleted; there is deliberately no `updatedAt`/soft-delete.
model AuditLog {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null means system-initiated (no human/service actor), not "unknown".
  actorUserId String? @map("actor_user_id") @db.Uuid

  action     String
  entityType String @map("entity_type")
  /// Stored as text (not a foreign key) so one audit table can reference any
  /// entity type across the whole application.
  entityId   String @map("entity_id")

  beforeState     Json? @map("before_state") @db.JsonB
  afterState      Json? @map("after_state") @db.JsonB
  requestMetadata Json? @map("request_metadata") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

/// Reliable-event foundation: written in the same transaction as the domain
/// change it describes, consumed asynchronously by outbox worker.
model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String            @map("event_type")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  payload       Json              @db.JsonB
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")

  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?   @map("locked_by")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, availableAt, createdAt])
  @@index([status, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Phase 2: Credentials, Sessions, Tokens & OTP
// ---------------------------------------------------------------------------

/// Password credentials for password-authenticated users. Hashed using
/// Argon2id / PBKDF2 with unique per-user salt. Passwords are never stored
/// or logged in plaintext.
model UserCredential {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash    String   @map("password_hash")
  algorithm       String   @default("argon2id")
  passwordVersion Int      @default(1) @map("password_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_credentials")
}

/// Server-authoritative user sessions. Raw session tokens are never stored
/// in plaintext; only the SHA-256 hash is persisted.
model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique @map("session_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

/// Single-use email verification tokens.
model EmailVerificationToken {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityId String       @map("identity_id") @db.Uuid
  identity   UserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique @map("token_hash")
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

/// Single-use password reset tokens.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// OTP verification challenges for phone authentication.
model OtpChallenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String    @map("phone_number")
  otpHash     String    @map("otp_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneNumber, createdAt])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Phase 3: System Configuration, Customer Profile, Saved Locations, Preferences
// ---------------------------------------------------------------------------

enum ConfigValueType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  JSON

  @@map("config_value_type")
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK

  @@map("theme_preference")
}

/// Centralized database-backed system configuration parameters.
model SystemConfiguration {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String          @unique
  value       String
  valueType   ConfigValueType @default(STRING) @map("value_type")
  description String?
  category    String          @default("system")
  isPublic    Boolean         @default(false) @map("is_public")
  updatedBy   String?         @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@map("system_configurations")
}

/// Customer profile data linked 1-to-1 with core User account.
model CustomerProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  displayName       String?   @map("display_name")
  avatarUrl         String?   @map("avatar_url")
  dateOfBirth       DateTime? @map("date_of_birth") @db.Timestamptz(6)
  defaultLocationId String?   @map("default_location_id") @db.Uuid

  customerRidePinHash      String?   @map("customer_ride_pin_hash")
  customerRidePinCreatedAt DateTime? @map("customer_ride_pin_created_at") @db.Timestamptz(6)
  customerRidePinUpdatedAt DateTime? @map("customer_ride_pin_updated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("customer_profiles")
}

/// Persistent user-saved locations with spatial coordinates for routing & PostGIS.
model SavedLocation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String // e.g. "Home", "Work", "Gym"
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  state        String
  country      String  @default("India")
  postalCode   String  @map("postal_code")
  latitude     Float
  longitude    Float
  isDefault    Boolean @default(false) @map("is_default")

  scheduledRides ScheduledRide[] @relation("SavedLocationScheduledRides")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, isDefault])
  @@map("saved_locations")
}

/// Extensible customer-specific preferences.
model CustomerPreference {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String          @unique @map("user_id") @db.Uuid
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                     ThemePreference @default(SYSTEM)
  language                  String          @default("en")
  languagesSpoken           String[]        @default(["en", "hi"]) @map("languages_spoken")
  pushNotificationsEnabled  Boolean         @default(true) @map("push_notifications_enabled")
  smsNotificationsEnabled   Boolean         @default(true) @map("sms_notifications_enabled")
  emailNotificationsEnabled Boolean         @default(true) @map("email_notifications_enabled")

  preferredVehicleCategory    String? @map("preferred_vehicle_category")
  preferredServiceType        String? @map("preferred_service_type")
  preferredPickupInstructions String? @map("preferred_pickup_instructions")
  preferredDriverProfileId    String? @map("preferred_driver_profile_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("customer_preferences")
}

/// Customer saved service recipients for reuse during booking.
model CustomerSavedPerson {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  customer     User     @relation("CustomerSavedPeople", fields: [customerId], references: [id], onDelete: Cascade)
  fullName     String   @map("full_name")
  phone        String   @map("phone")
  email        String?  @map("email")
  relationship String?  @map("relationship")
  notes        String?  @map("notes")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId, isActive])
  @@index([customerId, phone])
  @@map("customer_saved_people")
}

// ---------------------------------------------------------------------------
// Phase 4: Driver Domain, Onboarding, Documents, Verification, Approval & Availability
// ---------------------------------------------------------------------------

enum DriverOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  COMPLETED

  @@map("driver_onboarding_status")
}

enum DriverVerificationStatus {
  NOT_VERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED

  @@map("driver_verification_status")
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("driver_approval_status")
}

enum DriverAvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
  UNAVAILABLE

  @@map("driver_availability_status")
}

enum DriverDocumentType {
  DRIVING_LICENSE
  AADHAAR_CARD
  PROFILE_PHOTO
  BACKGROUND_VERIFICATION
  POLICE_VERIFICATION
  ADDRESS_PROOF

  @@map("driver_document_type")
}

enum DriverDocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
  SUPERSEDED

  @@map("driver_document_status")
}

/// Driver profile data linked 1-to-1 with core User account.
model DriverProfile {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                   @unique @map("user_id") @db.Uuid
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String?                  @map("first_name")
  lastName               String?                  @map("last_name")
  displayName            String?                  @map("display_name")
  profileImageUrl        String?                  @map("profile_image_url")
  dateOfBirth            DateTime?                @map("date_of_birth") @db.Timestamptz(6)
  gender                 String?
  bio                    String?
  drivingExperienceYears Int                      @default(0) @map("driving_experience_years")
  primaryServiceArea     String?                  @map("primary_service_area")
  languagesSpoken        String[]                 @default(["en", "hi"]) @map("languages_spoken")

  /// Driver-set rate for a full DAILY/WEEKLY/MONTHLY hire (not per-km/per-minute).
  /// Null means the driver has not opted into that hire type, so they are
  /// excluded from the customer-facing browsable list for it — see
  /// driver-hire-availability-service.ts.
  dailyHireRate   Decimal? @map("daily_hire_rate") @db.Decimal(12, 4)
  weeklyHireRate  Decimal? @map("weekly_hire_rate") @db.Decimal(12, 4)
  monthlyHireRate Decimal? @map("monthly_hire_rate") @db.Decimal(12, 4)
  onboardingStatus       DriverOnboardingStatus   @default(NOT_STARTED) @map("onboarding_status")
  verificationStatus     DriverVerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  approvalStatus         DriverApprovalStatus     @default(PENDING) @map("approval_status")
  availabilityStatus     DriverAvailabilityStatus @default(OFFLINE) @map("availability_status")
  rejectionReason        String?                  @map("rejection_reason")
  changesRequestedReason String?                  @map("changes_requested_reason")
  approvedAt             DateTime?                @map("approved_at") @db.Timestamptz(6)
  approvedBy             String?                  @map("approved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents            DriverDocument[]
  onboardingLogs       DriverOnboardingLog[]
  currentLocation      DriverCurrentLocation?
  locationHistory      DriverLocationHistory[]
  assignedBookings     Booking[]                  @relation("DriverBookings")
  preferredByBookings  Booking[]                  @relation("PreferredDriverBookings")
  assignmentAttempts   BookingAssignmentAttempt[]
  wallet               DriverWallet?
  settlements          DriverSettlement[]
  safetyIncidents      SafetyIncident[]           @relation("DriverSafetyIncidents")
  reliabilityIncidents TripReliabilityIncident[]  @relation("DriverReliabilityIncidents")
  reviews              Review[]                   @relation("DriverReviews")
  ratingSummary        DriverRatingSummary?
  driverCalls          CallSession[]              @relation("DriverCalls")
  schedules            DriverSchedule[]
  scheduleExceptions   DriverScheduleException[]
