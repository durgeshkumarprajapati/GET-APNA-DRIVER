  ticket         SupportTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId   String                  @map("author_user_id") @db.Uuid
  authorUser     User                    @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  authorRole     SupportTicketAuthorRole @map("author_role")
  isInternalNote Boolean                 @default(false) @map("is_internal_note")
  body           String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ticketId, isInternalNote, createdAt])
  @@index([authorUserId])
  @@map("support_messages")
}

/// Direct text message between a booking's customer and its assigned or
/// currently-offered driver. Authorization (who may read/send) is enforced
/// in booking-messaging-service.ts, not by this schema — a message thread
/// exists once a specific driver is associated with the booking (assigned,
/// or offered/preferred), not only after acceptance.
model BookingMessage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderUserId String    @map("sender_user_id") @db.Uuid
  sender       User      @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body         String
  messageType  String    @default("TEXT") @map("message_type")
  senderRole   String?   @map("sender_role")
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bookingId, createdAt])
  @@index([bookingId, readAt])
  @@map("booking_messages")
}

