// ---------------------------------------------------------------------------
// Phase 8: Payments, Razorpay, Commission, Financial Ledger, Wallet & Settlement
//
// Chart of accounts (seeded as LedgerAccount rows, see prisma/seed.ts):
//   PAYMENT_PROVIDER_CLEARING   (asset)     Funds Razorpay holds/has settled to the
//                                           platform on the platform's behalf.
//                                           Debited on capture, credited on refund.
//   PLATFORM_REVENUE_COMMISSION (revenue)   Platform's earned commission. Credited on
//                                           capture, debited (reversed) on refund.
//   DRIVER_PAYABLE               (liability) What the platform owes drivers for
//                                           completed, paid trips. Credited on capture,
//                                           debited on refund (clawback) and on
//                                           settlement creation (moves to clearing).
//   SETTLEMENT_CLEARING          (liability) Driver-payable amounts earmarked for
//                                           payout. Credited (increased) when a
//                                           settlement is created, debited when that
//                                           settlement is confirmed paid or reversed
//                                           (released back to DRIVER_PAYABLE) if it fails.
//   PLATFORM_BANK_ACCOUNT        (asset)     The platform's operating bank account.
//                                           Credited (decreased) when a settlement is
//                                           confirmed paid. Razorpay's own settlement of
//                                           collected funds into this account is out of
//                                           scope (no bank reconciliation in this phase).
//
// One payment capture posts a single balanced FinancialTransaction:
//   Dr PAYMENT_PROVIDER_CLEARING          amount
//       Cr PLATFORM_REVENUE_COMMISSION        commissionAmount
//       Cr DRIVER_PAYABLE                     driverEarningsAmount
// A refund posts the exact proportional reversal (see refund-service.ts).
// A settlement posts Dr DRIVER_PAYABLE / Cr SETTLEMENT_CLEARING on creation;
// Dr SETTLEMENT_CLEARING / Cr PLATFORM_BANK_ACCOUNT when confirmed paid; or
// the exact reversal of the creation posting if it fails/is cancelled before
// being paid. Ledger entries and FinancialTransaction rows are never updated
// or deleted after posting — see ledger-service.ts.
// ---------------------------------------------------------------------------

/// A Payment's own refund-in-progress state is intentionally NOT modeled
/// here (no REFUND_PENDING) — an individual Refund already tracks its own
/// PENDING/PROCESSING/PROCESSED/FAILED lifecycle (RefundStatus below), and a
/// Payment can have several Refunds over time, so "pending" is a property of
/// one Refund, not of the Payment as a whole.
enum PaymentStatus {
  CREATED
  PROCESSING
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED

  @@map("payment_attempt_status")
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_processing_status")
}

enum LedgerBalanceSide {
  DEBIT
  CREDIT

  @@map("ledger_balance_side")
}

enum FinancialTransactionType {
  PAYMENT_CAPTURED
  PAYMENT_REFUNDED
  SETTLEMENT_CREATED
  SETTLEMENT_PAID
  SETTLEMENT_REVERSED
  REFERRAL_REWARD
  INCENTIVE_REWARD

  @@map("financial_transaction_type")
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED

  @@map("settlement_status")
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("refund_status")
}

enum WalletChangeType {
  EARNING_RECOGNIZED
  EARNING_REVERSED
  SETTLEMENT_RESERVED
  SETTLEMENT_RELEASED
  SETTLEMENT_COMPLETED
  INCENTIVE_REWARD

  @@map("wallet_change_type")
}

enum IncentiveCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED

  @@map("incentive_campaign_status")
}

enum IncentiveType {
  TRIP_COUNT
  EARNINGS_THRESHOLD
  TIME_WINDOW

  @@map("incentive_type")
}

enum IncentiveProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  QUALIFIED
  REWARDED

  @@map("incentive_progress_status")
}

/// Business-level payment for a booking. A booking may have more than one
/// Payment row over time (a FAILED/CANCELLED attempt does not block retrying),
/// but application code enforces at most one non-terminal Payment per booking.
model Payment {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String  @map("customer_id") @db.Uuid
  customer   User    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Snapshot of which driver earns from this payment (copied from
  /// booking.driverProfileId at capture time). A loose reference, not a
  /// relation — consistent with other actor/reference columns in this schema
  /// (e.g. Booking.cancelledBy) that intentionally don't force a back-relation.
  driverProfileId String? @map("driver_profile_id") @db.Uuid

  amount   Decimal       @db.Decimal(19, 4)
  currency String        @default("INR")
  status   PaymentStatus @default(CREATED)

  provider          String  @default("razorpay")
  providerOrderId   String? @map("provider_order_id")
  providerPaymentId String? @map("provider_payment_id")

  /// Post-trip payment method chosen by customer: UPI, QR, CASH, or ONLINE.
  paymentMethod String? @map("payment_method")

  /// Cash payment confirmation timestamps (dual confirmation required).
  cashCustomerConfirmedAt DateTime? @map("cash_customer_confirmed_at") @db.Timestamptz(6)
  cashDriverConfirmedAt   DateTime? @map("cash_driver_confirmed_at") @db.Timestamptz(6)

  /// Client-supplied key for the "create payment order" request. Prevents
  /// creating two orders for the same checkout attempt on retry/double-click.
  idempotencyKey String? @unique @map("idempotency_key")

  /// Commission snapshot, fixed at capture time so a later SystemConfiguration
  /// change never retroactively changes an already-captured payment's split.
  commissionPercentageSnapshot Decimal? @map("commission_percentage_snapshot") @db.Decimal(7, 4)
  commissionAmount             Decimal? @map("commission_amount") @db.Decimal(19, 4)
  driverEarningsAmount         Decimal? @map("driver_earnings_amount") @db.Decimal(19, 4)

  /// Copied from the Booking's frozen promotion snapshot at payment-creation
  /// time (never recalculated). `amount` above is already net of this
  /// discount — it is what Razorpay actually charges. Commission and driver
  /// earnings are calculated on the gross fare (amount + discountAmount), so
  /// a platform-funded promotion never reduces what the driver is owed; see
  /// capturePayment's ledger posting, which books the gap as
  /// PROMOTION_DISCOUNT_EXPENSE.
  promotionId           String?  @map("promotion_id") @db.Uuid
  promotionCodeSnapshot String?  @map("promotion_code_snapshot")
  discountAmount        Decimal? @map("discount_amount") @db.Decimal(19, 4)

  failureReason String?   @map("failure_reason")
  capturedAt    DateTime? @map("captured_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempts    PaymentAttempt[]
  refunds     Refund[]
  taxInvoices TaxInvoice[]

  @@index([bookingId])
  @@index([customerId, status])
  @@index([status, createdAt])
  /// Supports the admin payments list's unfiltered "newest 200" query
  /// (listAllPayments) — a bare createdAt DESC scan with no status
  /// predicate, which none of the other indexes (all status-prefixed) cover.
  @@index([createdAt])
  @@map("payments")
}

/// One provider interaction (order creation, verification, or fetch) for a
/// Payment. A Payment may have several attempts (e.g. a failed try followed
/// by a retry that succeeds). Only a sanitized response snapshot is kept —
/// never raw card/PAN data.
model PaymentAttempt {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider          String
  providerOrderId   String?              @map("provider_order_id")
  providerPaymentId String?              @map("provider_payment_id")
  status            PaymentAttemptStatus @default(INITIATED)

  failureCode      String? @map("failure_code")
  failureReason    String? @map("failure_reason")
  /// Sanitized snapshot only (status/ids/amount) — never the full raw
  /// provider payload, which may carry more than is safe to retain.
  responseSnapshot Json?   @map("response_snapshot") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

/// Every relevant incoming Razorpay webhook, persisted before processing.
/// providerEventId is the `x-razorpay-event-id` header when present, else a
/// content hash of the raw body (see webhook-service.ts) — either way it is
/// stable across Razorpay's own retries of the same delivery, which is what
/// the unique constraint relies on for duplicate-safe, idempotent processing.
model PaymentWebhookEvent {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String  @default("razorpay")
  providerEventId   String  @map("provider_event_id")
  eventType         String  @map("event_type")
  payload           Json    @db.JsonB
  signatureVerified Boolean @map("signature_verified")

  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(6)
  errorDetails     String?                 @map("error_details")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([processingStatus, createdAt])
  @@map("payment_webhook_events")
}

/// Chart-of-accounts metadata only — an account's balance is always derived
/// by summing its LedgerEntry rows, never stored directly on this row.
model LedgerAccount {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String            @unique
  name          String
  description   String
  normalBalance LedgerBalanceSide @map("normal_balance")
  /// Seeded system accounts (see chart of accounts above); not
  /// creatable/deletable through admin tooling.
  isSystem      Boolean           @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

/// One logical, balanced accounting event (e.g. "payment captured"). Immutable
/// once created: never updated, never deleted. A correction is a new
/// FinancialTransaction whose `reversesTransactionId` points back at this one
/// — the original's rows are never touched.
model FinancialTransaction {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionType FinancialTransactionType @map("transaction_type")

  /// What business entity this transaction was posted for (e.g. "Payment",
  /// "DriverSettlement") — a loose polymorphic reference, matching AuditLog's
  /// entityType/entityId, not a hard per-type FK.
  referenceEntityType String @map("reference_entity_type")
  referenceEntityId   String @map("reference_entity_id") @db.Uuid

  /// Prevents double-posting the same logical event (e.g. the same webhook
  /// delivery processed twice must never post two FinancialTransactions).
  idempotencyKey String? @unique @map("idempotency_key")

  description           String
  /// Self-reference: set only on a compensating/reversing transaction.
  reversesTransactionId String? @map("reverses_transaction_id") @db.Uuid
  metadata              Json?   @db.JsonB

  postedAt  DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entries            LedgerEntry[]
  walletTransactions WalletTransaction[]
  incentiveProgress  DriverIncentiveProgress?

  @@index([referenceEntityType, referenceEntityId])
  @@index([transactionType, postedAt])
  @@map("financial_transactions")
}

/// One debit or credit line of a FinancialTransaction. Exactly one of
/// debitAmount/creditAmount is non-zero per row (enforced in
/// ledger-service.ts and by the deferred trigger in
/// prisma/sql/001_ledger_balance_trigger.sql, which also enforces
/// SUM(debits) = SUM(credits) per financial_transaction_id at commit time).
model LedgerEntry {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialTransactionId String               @map("financial_transaction_id") @db.Uuid
  financialTransaction   FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)
  ledgerAccountId        String               @map("ledger_account_id") @db.Uuid
  ledgerAccount          LedgerAccount        @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  debitAmount  Decimal @default(0) @map("debit_amount") @db.Decimal(19, 4)
  creditAmount Decimal @default(0) @map("credit_amount") @db.Decimal(19, 4)
  currency     String  @default("INR")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([financialTransactionId])
  @@index([ledgerAccountId])
  @@map("ledger_entries")
}

/// Driver balance projection. Read model only — the ledger remains
/// authoritative. Never updated directly by an API; every change is derived
/// from a FinancialTransaction and recorded as a WalletTransaction in the
/// same DB transaction (see wallet-service.ts).
model DriverWallet {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverProfileId String        @unique @map("driver_profile_id") @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  /// Eligible for settlement. In this phase, newly recognized earnings are
  /// credited here directly (no hold period yet — see wallet-service.ts).
  availableBalance Decimal @default(0) @map("available_balance") @db.Decimal(19, 4)
  /// Reserved for future use by a hold-period policy; not populated by any
  /// code path in this phase (always 0). Kept so that policy can be added
  /// later without a schema migration.
  pendingBalance   Decimal @default(0) @map("pending_balance") @db.Decimal(19, 4)
  /// Earmarked by an in-flight (PENDING/PROCESSING) settlement.
  reservedBalance  Decimal @default(0) @map("reserved_balance") @db.Decimal(19, 4)
  totalEarned      Decimal @default(0) @map("total_earned") @db.Decimal(19, 4)
  totalSettled     Decimal @default(0) @map("total_settled") @db.Decimal(19, 4)
  currency         String  @default("INR")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions WalletTransaction[]
  settlements  DriverSettlement[]

  @@map("driver_wallets")
}

/// Append-only explanation of why a driver's wallet balance changed. Snapshots
/// all three balances *after* the change for straightforward auditing/debugging.
model WalletTransaction {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverWalletId         String               @map("driver_wallet_id") @db.Uuid
  driverWallet           DriverWallet         @relation(fields: [driverWalletId], references: [id], onDelete: Cascade)
  financialTransactionId String               @map("financial_transaction_id") @db.Uuid
  financialTransaction   FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  changeType     WalletChangeType @map("change_type")
  /// Signed per-bucket deltas (positive increases, negative decreases). Kept
  /// separate rather than collapsed into one "amount" because a single
  /// change can move money *between* buckets (e.g. settlement reservation:
  /// availableDelta -100, reservedDelta +100) — netting those into one
  /// number would misleadingly show 0 for a real 100 movement.
  availableDelta Decimal          @default(0) @map("available_delta") @db.Decimal(19, 4)
  pendingDelta   Decimal          @default(0) @map("pending_delta") @db.Decimal(19, 4)
  reservedDelta  Decimal          @default(0) @map("reserved_delta") @db.Decimal(19, 4)

  balanceAfterAvailable Decimal @map("balance_after_available") @db.Decimal(19, 4)
  balanceAfterPending   Decimal @map("balance_after_pending") @db.Decimal(19, 4)
  balanceAfterReserved  Decimal @map("balance_after_reserved") @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Guarantees applyWalletChange is safe to call twice for the same
  /// FinancialTransaction (e.g. a webhook and a client-verify call racing to
  /// capture the same payment) — the second call's insert is rejected at the
  /// database level, not just by an application-level check-then-act guard.
  @@unique([driverWalletId, financialTransactionId])
  @@index([driverWalletId, createdAt])
  @@map("wallet_transactions")
}

/// Driver payout lifecycle. Creating a settlement reserves funds (moves them
/// from availableBalance to reservedBalance and posts DRIVER_PAYABLE ->
/// SETTLEMENT_CLEARING); there is no unconstrained "mark paid" — every
/// transition goes through settlement-service.ts's state machine.
model DriverSettlement {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverProfileId String        @map("driver_profile_id") @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  driverWalletId  String        @map("driver_wallet_id") @db.Uuid
  driverWallet    DriverWallet  @relation(fields: [driverWalletId], references: [id], onDelete: Restrict)

  amount     Decimal          @db.Decimal(19, 4)
  amountPaid Decimal?         @map("amount_paid") @db.Decimal(19, 4)
  currency   String           @default("INR")
  status     SettlementStatus @default(PENDING)

  /// "manual" in this phase (no automated payout provider is configured yet
  /// — see settlement-service.ts); ready for a future real payout provider.
  payoutProvider  String? @map("payout_provider")
  payoutReference String? @map("payout_reference")

  /// Loose references (not relations), consistent with other actor columns.
  requestedBy String? @map("requested_by") @db.Uuid
  processedBy String? @map("processed_by") @db.Uuid

  /// Loose references to the reserving/reversing FinancialTransaction rows.
  financialTransactionId         String? @map("financial_transaction_id") @db.Uuid
  reversalFinancialTransactionId String? @map("reversal_financial_transaction_id") @db.Uuid

  failureReason String?   @map("failure_reason")
  initiatedAt   DateTime? @map("initiated_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([driverProfileId, status])
  @@index([status, createdAt])
  @@map("driver_settlements")
}

/// Full or partial refund of a captured Payment. Never mutates the original
/// Payment/ledger rows — always creates a compensating FinancialTransaction.
model Refund {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  amount   Decimal      @db.Decimal(19, 4)
  currency String       @default("INR")
  status   RefundStatus @default(PENDING)
  reason   String?

  /// Sequential concurrency-safe refund document number (e.g. GAD-REF-2026-000001).
  refundNumber String? @unique @map("refund_number")

  /// Optional client-supplied key guarding against an accidental duplicate
  /// refund request; the maximum-refundable-amount check (in
  /// refund-service.ts) is the primary defense against over-refunding.
  idempotencyKey String? @unique @map("idempotency_key")

  providerRefundId       String? @map("provider_refund_id")
  /// Loose reference to the actor (admin) who initiated this refund.
  initiatedBy            String  @map("initiated_by") @db.Uuid
  /// Loose reference to the compensating FinancialTransaction once posted.
  financialTransactionId String? @map("financial_transaction_id") @db.Uuid

  failureReason String?   @map("failure_reason")
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([paymentId, status])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Phase 20: Promotions, Coupons, Offers & Growth Eligibility Engine
//
// Deliberately minimal: two models cover every required capability
// (code-based and automatic promotions, date windows, global and per-user
// usage limits, percentage/fixed discounts with a cap, minimum booking
// value, first-ride eligibility) without a generic "PromotionRule" table —
// the rule set is small and fixed today, so plain typed/indexed columns are
// simpler and more query-able than a polymorphic rules blob.
//
// Concurrency-safe usage limits: application code takes `SELECT ... FOR
// UPDATE` on the Promotion row inside the same transaction that creates the
// Booking, serializing every concurrent redemption attempt for that
// promotion (see promotion-eligibility-service.ts) — the same idiom already
// used by outbox-dispatcher-service.ts's `FOR UPDATE SKIP LOCKED` claim
// query. `totalUsageCount` is only ever mutated under that lock. The
// `@@unique([bookingId])` below is the second, independent guarantee: a
// single booking can never register two promotion usages even if
// application logic were ever called twice for it.
//
// Historical immutability: Booking and Payment each freeze the promotion
// terms that applied to them (promotionCodeSnapshot, discountType,
// discountAmount, ...) at the moment the discount was applied/charged —
// exactly the same pattern as Booking.pricingSnapshot and
// Payment.commissionPercentageSnapshot. A later edit to the Promotion row
// (e.g. an admin changing discountValue) never touches these snapshots.
// ---------------------------------------------------------------------------

enum PromotionDiscountType {
  PERCENTAGE
  FIXED

  @@map("promotion_discount_type")
}

/// DRAFT -> ACTIVE -> PAUSED -> ACTIVE (resume) -> ARCHIVED, or ACTIVE ->
/// ARCHIVED directly. EXPIRED is deliberately NOT a stored transition here —
/// there is no background scheduler in this codebase to sweep promotions on
/// their endsAt date (adding one would mean introducing a second
/// job-scheduling mechanism alongside the transactional outbox/worker, which
/// Phase 20 explicitly must not do). Instead "expired" is a *derived* read
/// state: an ACTIVE promotion whose endsAt has passed is treated as
/// unavailable wherever eligibility is evaluated, without ever mutating its
/// stored status column. See promotion-state-machine.ts.
enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("promotion_status")
}

model Promotion {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null => an automatic promotion (e.g. first-ride) that is evaluated and
  /// applied without the customer entering a code. Unique so a code can
  /// unambiguously resolve to one promotion.
  code String? @unique

  name        String
  description String?

  discountType      PromotionDiscountType @map("discount_type")
  /// Percentage points (0-100) when discountType=PERCENTAGE, or a flat
  /// rupee amount when discountType=FIXED.
  discountValue     Decimal               @map("discount_value") @db.Decimal(12, 4)
  /// Caps the computed discount; only meaningful for PERCENTAGE (a FIXED
  /// discount is already a hard amount). Null = uncapped.
  maxDiscountAmount Decimal?              @map("max_discount_amount") @db.Decimal(12, 4)
  /// Minimum gross fare required for this promotion to apply.
  minBookingValue   Decimal?              @map("min_booking_value") @db.Decimal(12, 4)

  /// Eligibility restricted to a customer with zero prior TRIP_COMPLETED
  /// bookings (see promotion-eligibility-service.ts's isFirstRideCustomer).
  firstRideOnly Boolean @default(false) @map("first_ride_only")
  /// True = auto-applied to an eligible booking with no code required
  /// (still subject to every other eligibility rule). A promotion may be
  /// both code-based (non-null code) and NOT automatic — the normal case —
  /// or code-less and automatic (e.g. first-ride).
  isAutomatic   Boolean @default(false) @map("is_automatic")

  status   PromotionStatus @default(DRAFT)
  startsAt DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime?       @map("ends_at") @db.Timestamptz(6)

  /// Null = unlimited redemptions platform-wide.
  totalUsageLimit   Int? @map("total_usage_limit")
  /// Authoritative running counter — mutated only inside a transaction that
  /// holds a `FOR UPDATE` lock on this row (see module doc comment above).
  totalUsageCount   Int  @default(0) @map("total_usage_count")
  /// Null = unlimited redemptions per customer.
  perUserUsageLimit Int? @default(1) @map("per_user_usage_limit")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  usages PromotionUsage[]
  loyaltyRewards LoyaltyReward[] @relation("RewardPromotion")

  @@index([status])
  @@index([startsAt, endsAt])
  @@map("promotions")
}

/// One redemption record per booking. The authoritative snapshot a Booking
/// carries (promotionCodeSnapshot etc. on Booking itself) is what payment
/// and refund logic actually reads; this row exists to enforce usage limits
/// and to give admins a queryable redemption history per promotion.
model PromotionUsage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookingId   String    @unique @map("booking_id") @db.Uuid
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  discountAmount        Decimal               @map("discount_amount") @db.Decimal(12, 4)
  /// Frozen at redemption time — a later change to the Promotion row (code,
  /// discount type/value) never alters this historical record.
  promotionCodeSnapshot String?               @map("promotion_code_snapshot")
  discountTypeSnapshot  PromotionDiscountType @map("discount_type_snapshot")
  discountValueSnapshot Decimal               @map("discount_value_snapshot") @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([promotionId, userId])
  @@map("promotion_usages")
}

enum DynamicPricingPolicyStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED

  @@map("dynamic_pricing_policy_status")
}

/// Controlled Dynamic Pricing Policy configuration governed by Admin authority.
model DynamicPricingPolicy {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  description             String?
  version                 Int                        @default(1)
  status                  DynamicPricingPolicyStatus @default(DRAFT)
  bookingType             BookingType?               @map("booking_type")
  zoneId                  String?                    @map("zone_id")
  minimumPressure         String                     @default("NORMAL") @map("minimum_pressure")
  maximumPressure         String                     @default("CRITICAL") @map("maximum_pressure")
  adjustmentPercentage    Decimal                    @default(0) @map("adjustment_percentage") @db.Decimal(8, 4)
  maxAdjustmentPercentage Decimal                    @default(50.00) @map("max_adjustment_percentage") @db.Decimal(8, 4)
  flatSurgeAmount         Decimal                    @default(0) @map("flat_surge_amount") @db.Decimal(12, 4)
  effectiveFrom           DateTime?                  @map("effective_from") @db.Timestamptz(6)
  effectiveUntil          DateTime?                  @map("effective_until") @db.Timestamptz(6)
  createdBy               String?                    @map("created_by") @db.Uuid
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, bookingType])
  @@index([effectiveFrom, effectiveUntil])
  @@map("dynamic_pricing_policies")
}

// ---------------------------------------------------------------------------
// Phase 9: Notifications, Push Delivery, Preferences & Admin Campaigns
// ---------------------------------------------------------------------------

enum NotificationType {
  BOOKING_CREATED
  BOOKING_DRIVER_OFFERED
  BOOKING_DRIVER_ASSIGNED
  BOOKING_DRIVER_EN_ROUTE
  BOOKING_DRIVER_ARRIVED
  BOOKING_TRIP_STARTED
  BOOKING_TRIP_COMPLETED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  BOOKING_MESSAGE_RECEIVED
  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  DRIVER_APPLICATION_APPROVED
  DRIVER_APPLICATION_REJECTED
  DRIVER_APPLICATION_CHANGES_REQUESTED
  DRIVER_DOCUMENT_VERIFIED
