/// Core marketplace booking record. Stores customer booking snapshot, status,
/// location snapshot, driver assignment reference, and lifecycle metadata.
model Booking {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String? @unique @map("idempotency_key")
  customerId     String  @map("customer_id") @db.Uuid
  customer       User    @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)

  driverProfileId String?        @map("driver_profile_id") @db.Uuid
  driverProfile   DriverProfile? @relation("DriverBookings", fields: [driverProfileId], references: [id], onDelete: SetNull)

  /// Customer's non-binding preference, set at booking creation from one of
  /// their own CustomerFavoriteDriver entries. Read by matching-service to
  /// prioritize this driver if (and only if) they surface as an eligible,
  /// nearby candidate in the normal dispatch pool — never bypasses
  /// eligibility/availability/schedule/compliance/distance checks, and never
  /// guarantees assignment. driverProfileId above remains the sole source of
  /// truth for who was actually assigned.
  preferredDriverProfileId String?        @map("preferred_driver_profile_id") @db.Uuid
  preferredDriver          DriverProfile? @relation("PreferredDriverBookings", fields: [preferredDriverProfileId], references: [id], onDelete: SetNull)

  /// Optional customer vehicle requirement (e.g. MINI_CAR, CAR, SUV, TRUCK).
  /// Enforces capability matching during driver assignment and dispatch.
  vehicleCategoryId String?          @map("vehicle_category_id") @db.Uuid
  vehicleCategory   VehicleCategory? @relation(fields: [vehicleCategoryId], references: [id], onDelete: SetNull)

  /// Frozen snapshot of the chosen driver's own hire rate (DriverProfile.
  /// dailyHireRate/weeklyHireRate/monthlyHireRate), for DAILY/WEEKLY/MONTHLY
  /// bookings only, captured at creation and reused unchanged for the final
  /// fare at trip completion — a later change to the driver's listed rate
  /// must never alter what this customer already agreed to pay.
  driverCustomRateSnapshot Decimal? @map("driver_custom_rate_snapshot") @db.Decimal(12, 4)

  status      BookingStatus @default(DRAFT)
  bookingType BookingType   @default(ONE_WAY) @map("booking_type")

  // Pickup location snapshot for historical correctness
  pickupLatitude  Float   @map("pickup_latitude")
  pickupLongitude Float   @map("pickup_longitude")
  pickupAddress   String  @map("pickup_address")
  pickupLabel     String? @map("pickup_label")

  // Dropoff location snapshot (optional for flexible trips / required for one-way)
  dropoffLatitude  Float?  @map("dropoff_latitude")
  dropoffLongitude Float?  @map("dropoff_longitude")
  dropoffAddress   String? @map("dropoff_address")
  dropoffLabel     String? @map("dropoff_label")

  // Booking package & pricing parameters
  numberOfDays       Int?      @map("number_of_days")
  hourlyPackageHours Int?      @map("hourly_package_hours")
  returnDate         DateTime? @map("return_date") @db.Timestamptz(6)

  // Duration-based driver hire parameters
  hireDurationMinutes Int?      @map("hire_duration_minutes")
  hireStartAt         DateTime? @map("hire_start_at") @db.Timestamptz(6)
  hireEndAt           DateTime? @map("hire_end_at") @db.Timestamptz(6)

  // Fare calculation and route snapshot
  estimatedDistanceKm   Float?   @map("estimated_distance_km")
  estimatedFareAmount   Decimal? @map("estimated_fare_amount") @db.Decimal(12, 4)
  finalFareAmount       Decimal? @map("final_fare_amount") @db.Decimal(12, 4)
  pricingSnapshot       Json?    @map("pricing_snapshot")
  routeEstimateSnapshot Json?    @map("route_estimate_snapshot")

  /// Frozen promotion terms, if any, validated and applied at booking
  /// creation time (see promotion-eligibility-service.ts). A later change to
  /// the Promotion row (or its deactivation) never alters these — the same
  /// immutable-snapshot treatment as pricingSnapshot above and
  /// Payment.commissionPercentageSnapshot.
  promotionId           String?                @map("promotion_id") @db.Uuid
  promotionCodeSnapshot String?                @map("promotion_code_snapshot")
  discountType          PromotionDiscountType? @map("discount_type")
  discountAmount        Decimal?               @map("discount_amount") @db.Decimal(12, 4)

  requestedStartTime       DateTime? @map("requested_start_time") @db.Timestamptz(6)
  estimatedDurationMinutes Int?      @map("estimated_duration_minutes")
  customerNotes            String?   @map("customer_notes")

  requestedAt        DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  searchStartedAt    DateTime? @map("search_started_at") @db.Timestamptz(6)
  assignedAt         DateTime? @map("assigned_at") @db.Timestamptz(6)
  driverEnRouteAt    DateTime? @map("driver_en_route_at") @db.Timestamptz(6)
  driverArrivedAt    DateTime? @map("driver_arrived_at") @db.Timestamptz(6)
  tripStartedAt      DateTime? @map("trip_started_at") @db.Timestamptz(6)
  tripCompletedAt    DateTime? @map("trip_completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancellationReason String?   @map("cancellation_reason")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)

  ridePinVerifiedAt               DateTime? @map("ride_pin_verified_at") @db.Timestamptz(6)
  ridePinVerifiedByDriverId       String?   @map("ride_pin_verified_by_driver_id") @db.Uuid
  ridePinVerificationAttemptCount Int       @default(0) @map("ride_pin_verification_attempt_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignmentAttempts BookingAssignmentAttempt[]
  bookingLogs        BookingLog[]
  payments           Payment[]
  safetyIncidents    SafetyIncident[]           @relation("BookingSafetyIncidents")
  disputes           Dispute[]                  @relation("BookingDisputes")
  review             Review?
  promotionUsage     PromotionUsage?
  supportTickets           SupportTicket[]
  callSessions             CallSession[]
  messages                 BookingMessage[]
  taxInvoice               TaxInvoice?
  loyaltyTransactions      LoyaltyPointTransaction[]  @relation("BookingLoyaltyTransactions")
  scheduledRideId          String?                    @map("scheduled_ride_id") @db.Uuid
  scheduledRide            ScheduledRide?             @relation("GeneratedBookings", fields: [scheduledRideId], references: [id], onDelete: SetNull)
  scheduledRideOccurrences ScheduledRideOccurrenceLog[]
  tripIntelligenceEvents   TripIntelligenceEvent[]
  reliabilityIncidents     TripReliabilityIncident[]  @relation("BookingReliabilityIncidents")
  serviceRecipient         BookingServiceRecipient?

  // Corporate / Business Travel extension fields
  organizationId    String?                   @map("organization_id") @db.Uuid
  organization      Organization?             @relation("OrganizationBookings", fields: [organizationId], references: [id], onDelete: SetNull)
  bookedForUserId   String?                   @map("booked_for_user_id") @db.Uuid
  bookedForUser     User?                     @relation("BookedForUserBookings", fields: [bookedForUserId], references: [id], onDelete: SetNull)
  costCenterId      String?                   @map("cost_center_id") @db.Uuid
  costCenter        OrganizationCostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  departmentId      String?                   @map("department_id") @db.Uuid
  department        OrganizationDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  businessPurpose   String?                   @map("business_purpose")
  approvalRequestId String?                   @map("approval_request_id") @db.Uuid
  approvalRequest   CorporateApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  // Controlled Dynamic Pricing snapshot fields
  dynamicAdjustmentAmount   Decimal? @map("dynamic_adjustment_amount") @db.Decimal(12, 4)
  dynamicPricingPolicyId    String?  @map("dynamic_pricing_policy_id") @db.Uuid
  dynamicPricingPolicyVersion Int?   @map("dynamic_pricing_policy_version")
  pressureState             String?  @map("pressure_state")

  @@index([customerId, status])
  @@index([driverProfileId, status])
  @@index([driverProfileId, hireStartAt, hireEndAt, status])
  @@index([organizationId, status])
  @@index([scheduledRideId])
  @@index([status, createdAt])
  @@map("bookings")
}

