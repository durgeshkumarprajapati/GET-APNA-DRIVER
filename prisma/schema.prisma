model SupportTicket {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber    String                @unique @map("ticket_number")
  customerId      String                @map("customer_id") @db.Uuid
  customer        User                  @relation("CustomerSupportTickets", fields: [customerId], references: [id], onDelete: Restrict)
  bookingId       String?               @map("booking_id") @db.Uuid
  booking         Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category        SupportTicketCategory
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(NORMAL)
  subject         String
  description     String
  assignedAdminId String?               @map("assigned_admin_id") @db.Uuid
  assignedAdmin   User?                 @relation("AssignedSupportTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages     SupportMessage[]
  callSessions CallSession[]

  @@index([customerId, status, createdAt])
